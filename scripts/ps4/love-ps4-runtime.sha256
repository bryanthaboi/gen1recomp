# LÖVE for PS4 pinned runtime, built from bryanthaboi/love-ps4 (fork of tomasmorello/love-ps4)
# https://github.com/bryanthaboi/love-ps4/releases
#
# scripts/build_ps4.sh --fetch downloads <zip> from <repo> release <tag> and refuses
