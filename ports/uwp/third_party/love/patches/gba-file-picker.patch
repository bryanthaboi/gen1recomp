+// Extensions are supplied by the Lua importer descriptor, without dots.
+// Validate before opening the asynchronous picker; never accept wildcards.
+bool parseRomFormats(const char *formats, std::vector<std::string> &extensions)
+{
+	std::string remaining = formats ? formats : "gb,gbc,gba";
+	if (remaining.empty()) return false;
+	for (size_t start = 0; start < remaining.size();)
+	{
+		size_t end = remaining.find(',', start);
+		std::string extension = remaining.substr(start, end == std::string::npos
+			? std::string::npos : end - start);
+		if (extension.empty() || extension.find_first_not_of(
+			"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789") != std::string::npos)
+			return false;
+		extensions.push_back("." + extension);
+		if (end == std::string::npos) return true;
+		start = end + 1;
+		if (start == remaining.size()) return false;
+	}
+	return false;
+}
+
+void openPicker(const std::string &kind, const std::vector<std::string> &extensions)
@@ -62,0 +86,5 @@
+		else if (kind == "cart")
