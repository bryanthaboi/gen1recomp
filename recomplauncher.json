{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Gen1Recomp",
  "repo": "bryanthaboi/gen1recomp",
  "inputs": [
    { "id": "rom-red", "label": "Your Pokemon Red ROM (.gb, or a .zip / .7z that holds it). The US English release.", "optional": true, "formats": [{ "type": "file", "extensions": ["gb", "zip", "7z"] }] },
    { "id": "rom-blue", "label": "Your Pokemon Blue ROM (.gb, or a .zip / .7z that holds it). The US English release.", "optional": true, "formats": [{ "type": "file", "extensions": ["gb", "zip", "7z"] }] },
    { "id": "rom-yellow", "label": "Your Pokemon Yellow ROM (.gb, or a .zip / .7z that holds it). The US English release.", "optional": true, "formats": [{ "type": "file", "extensions": ["gb", "zip", "7z"] }] },
    { "id": "rom-gold", "label": "Your Pokemon Gold ROM (.gbc, or a .zip / .7z that holds it). The US English release.", "optional": true, "formats": [{ "type": "file", "extensions": ["gbc", "zip", "7z"] }] },
    { "id": "rom-silver", "label": "Your Pokemon Silver ROM (.gbc, or a .zip / .7z that holds it). The US English release.", "optional": true, "formats": [{ "type": "file", "extensions": ["gbc", "zip", "7z"] }] },
    { "id": "rom-crystal", "label": "Your Pokemon Crystal ROM (.gbc, or a .zip / .7z that holds it). The US English release, version 1.0 or 1.1.", "optional": true, "formats": [{ "type": "file", "extensions": ["gbc", "zip", "7z"] }] },
    { "id": "rom-firered", "label": "Your Pokemon FireRed ROM (.gba, or a .zip / .7z that holds it). The US English release, version 1.0 or 1.1.", "optional": true, "formats": [{ "type": "file", "extensions": ["gba", "zip", "7z"] }] },
    { "id": "rom-leafgreen", "label": "Your Pokemon LeafGreen ROM (.gba, or a .zip / .7z that holds it). The US English release, version 1.0 or 1.1.", "optional": true, "formats": [{ "type": "file", "extensions": ["gba", "zip", "7z"] }] },
    { "id": "rom-ruby", "label": "Your Pokemon Ruby ROM (.gba, or a .zip / .7z that holds it). The US English release, version 1.0, 1.1 or 1.2.", "optional": true, "formats": [{ "type": "file", "extensions": ["gba", "zip", "7z"] }] },
    { "id": "rom-sapphire", "label": "Your Pokemon Sapphire ROM (.gba, or a .zip / .7z that holds it). The US English release, version 1.0, 1.1 or 1.2.", "optional": true, "formats": [{ "type": "file", "extensions": ["gba", "zip", "7z"] }] },
    { "id": "rom-emerald", "label": "Your Pokemon Emerald ROM (.gba, or a .zip / .7z that holds it). The US English release.", "optional": true, "formats": [{ "type": "file", "extensions": ["gba", "zip", "7z"] }] }
  ],
  "games": [
    { "id": "red", "name": "Pokemon Red", "args": ["--game=red"], "inputs": ["rom-red"] },
    { "id": "blue", "name": "Pokemon Blue", "args": ["--game=blue"], "inputs": ["rom-blue"] },
    { "id": "yellow", "name": "Pokemon Yellow", "args": ["--game=yellow"], "inputs": ["rom-yellow"] },
    { "id": "gold", "name": "Pokemon Gold", "args": ["--game=gold"], "inputs": ["rom-gold"] },
    { "id": "silver", "name": "Pokemon Silver", "args": ["--game=silver"], "inputs": ["rom-silver"] },
    { "id": "crystal", "name": "Pokemon Crystal", "args": ["--game=crystal"], "inputs": ["rom-crystal"] },
    { "id": "firered", "name": "Pokemon FireRed", "args": ["--game=firered"], "inputs": ["rom-firered"] },
    { "id": "leafgreen", "name": "Pokemon LeafGreen", "args": ["--game=leafgreen"], "inputs": ["rom-leafgreen"] },
    { "id": "ruby", "name": "Pokemon Ruby", "args": ["--game=ruby"], "inputs": ["rom-ruby"] },
    { "id": "sapphire", "name": "Pokemon Sapphire", "args": ["--game=sapphire"], "inputs": ["rom-sapphire"] },
    { "id": "emerald", "name": "Pokemon Emerald", "args": ["--game=emerald"], "inputs": ["rom-emerald"] }
  ],
  "start": {
    "program": ["gen1recomp.exe"],
    "args": [
      "--rom={input:rom-red}",
      "--rom={input:rom-blue}",
      "--rom={input:rom-yellow}",
      "--rom={input:rom-gold}",
      "--rom={input:rom-silver}",
      "--rom={input:rom-crystal}",
      "--rom={input:rom-firered}",
      "--rom={input:rom-leafgreen}",
      "--rom={input:rom-ruby}",
      "--rom={input:rom-sapphire}",
      "--rom={input:rom-emerald}"
    ]
  }
}
